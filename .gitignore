.DS_Store
*.app/
build/
docs/assets/*.mp4
docs/assets/frames/

# serena's index and its notes about this checkout, written by whichever agent is working here
.serena/

# Private per-project state pages served through authenticated Project links. These stay local;
# public documentation belongs in docs/, and the server still applies its project jail and CSP.
.clawdline-private/

# swift build, which is only ever run to give an editor something to index
.build/
.swiftpm/
Package.resolved

# Frames and working files from tools/shoot-assets.sh — large, and regenerated on demand.
.shoot/

# Internal working artifacts. They live in the private sibling repo (clawdline-cloud) and are read
# and written there; this path is only a door into it. Anything meant for the community goes in
# docs/ instead — English, written from the outside, tracked, and safe for a test to depend on.
# Local working artifacts — now a symlink into the private sibling repo (clawdline-cloud),
# where they are tracked. Ignored here either way; no trailing slash so the symlink matches.
artifacts

# Python bytecode from tools/, which are scripts and not a package.
__pycache__/

# Personal Claude Code skills for this checkout, not part of the app.
.claude/skills/
