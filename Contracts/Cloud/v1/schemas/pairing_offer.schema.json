{
  "$id": "urn:clawdline:cloud:contract:1:pairing_offer",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Eleven-field canonical viewer offer. Fingerprint, distinct nonces, expiry and account bindings also require semantic checks.",
  "properties": {
    "account_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\x20-\\x7e]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "claim_nonce": {
      "maxLength": 44,
      "minLength": 44,
      "pattern": "^[A-Za-z0-9+/]{40}[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=(?![\\s\\S])",
      "type": "string"
    },
    "expires_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "pairing_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\x20-\\x7e]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "pairing_nonce": {
      "maxLength": 44,
      "minLength": 44,
      "pattern": "^[A-Za-z0-9+/]{40}[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=(?![\\s\\S])",
      "type": "string"
    },
    "type": {
      "const": "pairing_offer"
    },
    "v": {
      "const": 1,
      "type": "integer"
    },
    "viewer_device_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\x20-\\x7e]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "viewer_ephemeral_key": {
      "maxLength": 44,
      "minLength": 44,
      "pattern": "^[A-Za-z0-9+/]{40}[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=(?![\\s\\S])",
      "type": "string"
    },
    "viewer_fingerprint": {
      "maxLength": 19,
      "minLength": 19,
      "pattern": "^[A-Z2-7]{4}(?:-[A-Z2-7]{4}){3}(?![\\s\\S])",
      "type": "string"
    },
    "viewer_signing_key": {
      "maxLength": 44,
      "minLength": 44,
      "pattern": "^[A-Za-z0-9+/]{40}[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "claim_nonce",
    "expires_at",
    "pairing_id",
    "pairing_nonce",
    "type",
    "v",
    "viewer_device_id",
    "viewer_ephemeral_key",
    "viewer_fingerprint",
    "viewer_signing_key"
  ],
  "title": "pairing_offer",
  "type": "object"
}
