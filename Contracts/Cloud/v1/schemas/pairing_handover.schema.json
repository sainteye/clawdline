{
  "$id": "urn:clawdline:cloud:contract:1:pairing_handover",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Eight-field decrypted endpoint payload. Never send plaintext to API or Relay; machine fingerprint must match the signing key.",
  "properties": {
    "account_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\x20-\\x7e]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "key_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\x20-\\x7e]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "machine_fingerprint": {
      "maxLength": 19,
      "minLength": 19,
      "pattern": "^[A-Z2-7]{4}(?:-[A-Z2-7]{4}){3}(?![\\s\\S])",
      "type": "string"
    },
    "machine_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\x20-\\x7e]{1,128}(?![\\s\\S])",
      "type": "string"
    },
    "machine_signing_key": {
      "maxLength": 44,
      "minLength": 44,
      "pattern": "^[A-Za-z0-9+/]{40}[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=(?![\\s\\S])",
      "type": "string"
    },
    "master_secret": {
      "maxLength": 44,
      "minLength": 44,
      "pattern": "^[A-Za-z0-9+/]{40}[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=(?![\\s\\S])",
      "type": "string"
    },
    "type": {
      "const": "pairing_handover"
    },
    "v": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "account_id",
    "key_id",
    "machine_fingerprint",
    "machine_id",
    "machine_signing_key",
    "master_secret",
    "type",
    "v"
  ],
  "title": "pairing_handover",
  "type": "object"
}
