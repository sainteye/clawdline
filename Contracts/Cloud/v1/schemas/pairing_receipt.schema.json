{
  "$id": "urn:clawdline:cloud:contract:1:pairing_receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Canonical pairing finalization bytes, not a command-effect or human-observation receipt. Empty rotation/viewer sentinels remain literal empty strings.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "confirm_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        },
        "finalized_at": {
          "maxLength": 24,
          "minLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])",
          "type": "string"
        },
        "pairing_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e]{1,128}(?![\\s\\S])",
          "type": "string"
        },
        "released_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "released_rows": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "rotation_id": {
          "maxLength": 128,
          "minLength": 0,
          "pattern": "^[\\x20-\\x7e]{0,128}(?![\\s\\S])",
          "type": "string"
        },
        "status": {
          "const": "delivered"
        },
        "v": {
          "const": 1,
          "type": "integer"
        },
        "viewer_device_id": {
          "maxLength": 128,
          "minLength": 0,
          "pattern": "^[\\x20-\\x7e]{0,128}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "confirm_sha256",
        "finalized_at",
        "pairing_id",
        "released_bytes",
        "released_rows",
        "rotation_id",
        "status",
        "v",
        "viewer_device_id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "start_retry_cleanup"
              }
            }
          },
          "then": {
            "properties": {
              "viewer_device_id": {
                "const": ""
              }
            }
          }
        }
      ],
      "properties": {
        "finalized_at": {
          "maxLength": 24,
          "minLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])",
          "type": "string"
        },
        "pairing_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e]{1,128}(?![\\s\\S])",
          "type": "string"
        },
        "reason": {
          "enum": [
            "expired",
            "manual_revoke",
            "start_retry_cleanup"
          ]
        },
        "released_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "released_rows": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "rotation_id": {
          "maxLength": 128,
          "minLength": 0,
          "pattern": "^[\\x20-\\x7e]{0,128}(?![\\s\\S])",
          "type": "string"
        },
        "status": {
          "const": "released"
        },
        "v": {
          "const": 1,
          "type": "integer"
        },
        "viewer_device_id": {
          "maxLength": 128,
          "minLength": 0,
          "pattern": "^[\\x20-\\x7e]{0,128}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "finalized_at",
        "pairing_id",
        "reason",
        "released_bytes",
        "released_rows",
        "rotation_id",
        "status",
        "v",
        "viewer_device_id"
      ],
      "type": "object"
    }
  ],
  "title": "pairing_receipt"
}
