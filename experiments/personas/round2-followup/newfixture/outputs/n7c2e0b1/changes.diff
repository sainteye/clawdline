 // overlaps reports whether a and b share any instant, including their end
-// points: [9:00, 10:00] and [10:00, 11:00] overlap at 10:00.
-//
-// TODO(2021-06): this should be half-open like everywhere else. Back-to-back
-// meetings are rejected because of this.
+// points: [9:00, 10:00] and [10:00, 11:00] overlap at 10:00. Used for
+// maintenance and cleaning windows, which are closed intervals (FAC-12).
 func overlaps(a, b Interval) bool {
 	return !a.End.Before(b.Start) && !b.End.Before(a.Start)
 }
 
+// overlapsHalfOpen reports whether a and b share any instant, treating each
+// interval as half-open: [9:00, 10:00) and [10:00, 11:00) do not overlap.
+func overlapsHalfOpen(a, b Interval) bool {
+	return a.Start.Before(b.End) && b.Start.Before(a.End)
