+// bracketIndexInclusive is like bracketIndex, but limits are inclusive
+// ("up to and including"), like the letter table and the zone table.
+func bracketIndexInclusive(limits []int, v int) int {
+	for i, limit := range limits {
+		if v <= limit {
+			return i
+		}
+	}
+	return len(limits)
