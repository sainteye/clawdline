{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-assistant-charters.v1",
  "title": "Bots team charters",
  "description": "API 122; removing a charter arrives at API 123, and the Bots' conflict reports at API 124. One Markdown team charter per Project of a machine, kept as immutable versions. Every Bot of the Project follows the current version; it wins over a Bot's instructions and memory. Every write carries Idempotency-Key equal to its idempotency_key. All timestamps are RFC3339 UTC strings.",
  "$defs": {
    "ProjectAssistantCharterAuthor": {
      "type": "string",
      "enum": [
        "person",
        "lead_proposal",
        "restore",
        "template",
        "removed"
      ],
      "description": "How a charter version came to be. A removed version is the Project's charter being taken away: its text is empty, and while it is the newest version the Project has no charter (version 0)."
    },
    "ProjectAssistantCharterLimits": {
      "type": "object",
      "additionalProperties": false,
      "description": "The charter bounds the source enforces.",
      "properties": {
        "text_bytes": {
          "type": "integer"
        },
        "versions": {
          "type": "integer"
        },
        "proposals": {
          "type": "integer"
        },
        "reason_bytes": {
          "type": "integer"
        },
        "request_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "text_bytes",
        "versions",
        "proposals",
        "reason_bytes",
        "request_bytes"
      ]
    },
    "ProjectAssistantCharterSummary": {
      "type": "object",
      "additionalProperties": false,
      "description": "One Project's current charter in the machine listing.",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": "string"
        },
        "updated_by": {
          "$ref": "#/$defs/ProjectAssistantCharterAuthor"
        },
        "pending_proposals": {
          "type": "integer",
          "minimum": 0
        },
        "open_conflicts": {
          "type": "integer",
          "minimum": 0,
          "description": "Open conflict reports from the Project's Bots (API 124); absent from an older daemon."
        }
      },
      "required": [
        "project_id",
        "version",
        "updated_at",
        "updated_by",
        "pending_proposals"
      ]
    },
    "ProjectAssistantChartersResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every Project of the machine with a charter, and the Projects that have Bots but no charter yet.",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "machine_id": {
          "type": "string"
        },
        "charters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantCharterSummary"
          }
        },
        "projects_without_charter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "$ref": "#/$defs/ProjectAssistantCharterLimits"
        }
      },
      "required": [
        "contract_version",
        "machine_id",
        "charters",
        "projects_without_charter",
        "limits"
      ]
    },
    "ProjectAssistantCharterVersion": {
      "type": "object",
      "additionalProperties": false,
      "description": "One immutable charter version. text is present only on the version a read selected.",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "author": {
          "$ref": "#/$defs/ProjectAssistantCharterAuthor"
        },
        "reason": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "author",
        "reason",
        "created_at"
      ]
    },
    "ProjectAssistantCharterResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Project's current charter and its retained history, newest first. Version 0 means it has no charter. selected is the version a read named with version > 0.",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantCharterVersion"
          }
        },
        "selected": {
          "$ref": "#/$defs/ProjectAssistantCharterVersion"
        },
        "pending_proposals": {
          "type": "integer",
          "minimum": 0
        },
        "limits": {
          "$ref": "#/$defs/ProjectAssistantCharterLimits"
        }
      },
      "required": [
        "contract_version",
        "machine_id",
        "project_id",
        "version",
        "text",
        "history",
        "pending_proposals",
        "limits"
      ]
    },
    "ProjectAssistantCharterSaveRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Save the whole new text as the next version while the charter is still at expected_version (0 when it has none). A stale base answers pa_stale_version with field charter_version.",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "machine_id",
        "project_id",
        "idempotency_key",
        "expected_version",
        "text"
      ]
    },
    "ProjectAssistantCharterRestoreRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Save a copy of a retained earlier version as the next version.",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "machine_id",
        "project_id",
        "idempotency_key",
        "expected_version",
        "version"
      ]
    },
    "ProjectAssistantCharterRemoveRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Remove the Project's charter while it is still at expected_version (API 123). Every Bot of the Project hears once that there is no charter; fresh sessions get none. The retained versions stay, and a later save starts a new charter after them.",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "machine_id",
        "project_id",
        "idempotency_key",
        "expected_version"
      ]
    },
    "ProjectAssistantCharterReader": {
      "type": "object",
      "additionalProperties": false,
      "description": "One Bot of the Project: the charter version its most recent prompt carried (0 before any) and whether it has a running or queued turn now.",
      "properties": {
        "bot_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lead": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "turn_id": {
          "type": "string"
        },
        "read_at": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "queued": {
          "type": "boolean"
        }
      },
      "required": [
        "bot_id",
        "name",
        "lead",
        "hidden",
        "version",
        "turn_id",
        "running",
        "queued"
      ]
    },
    "ProjectAssistantCharterReadersResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which charter version each Bot of the Project last worked under.",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "readers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantCharterReader"
          }
        }
      },
      "required": [
        "contract_version",
        "machine_id",
        "project_id",
        "version",
        "readers"
      ]
    },
    "ProjectAssistantCharterProposal": {
      "type": "object",
      "additionalProperties": false,
      "description": "A lead Bot's pending proposal: the whole replacement text. stale says the charter moved past base_version, so applying it is refused.",
      "properties": {
        "id": {
          "type": "string"
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "bot_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "base_version",
        "text",
        "summary",
        "bot_id",
        "turn_id",
        "created_at",
        "stale"
      ]
    },
    "ProjectAssistantCharterProposalsResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Project's pending lead proposals, oldest first.",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantCharterProposal"
          }
        }
      },
      "required": [
        "contract_version",
        "machine_id",
        "project_id",
        "version",
        "proposals"
      ]
    },
    "ProjectAssistantCharterApplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Apply a pending proposal while the charter is still at expected_version. A proposal written against another version answers pa_stale_version with field charter_proposal_base.",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "machine_id",
        "project_id",
        "idempotency_key",
        "proposal_id",
        "expected_version"
      ]
    },
    "ProjectAssistantCharterDismissRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Dismiss a pending proposal. Dismissing one that is already gone answers the current list.",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        }
      },
      "required": [
        "machine_id",
        "project_id",
        "idempotency_key",
        "proposal_id"
      ]
    },
    "ProjectAssistantCharterChangeRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "The person's words from a charter page, sent to the machine's lead Bot as their own message. The lead's turn carries the Project's charter and may answer with a proposal.",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "machine_id",
        "project_id",
        "idempotency_key",
        "text"
      ]
    },
    "ProjectAssistantCharterChangeResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "The lead Bot that received the change request and the send receipt.",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "lead_bot_id": {
          "type": "string"
        },
        "receipt": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantReceipt"
        }
      },
      "required": [
        "contract_version",
        "machine_id",
        "project_id",
        "lead_bot_id",
        "receipt"
      ]
    },
    "ProjectAssistantCharterConflictSource": {
      "type": "string",
      "enum": [
        "memory",
        "instructions",
        "workspace_file"
      ],
      "description": "Where the Bot's sentence lives: its memory, its instructions, or a file in its workspace its instructions point to."
    },
    "ProjectAssistantCharterConflictState": {
      "type": "string",
      "enum": [
        "open",
        "fixed",
        "handed_to_bot",
        "handed_to_charter"
      ],
      "description": "What became of a report. fixed: the daemon replaced the Bot's sentence; handed_to_bot: the Bot was asked to change it itself; handed_to_charter: the person chose to change the charter instead. Dismissed and superseded reports are not listed."
    },
    "ProjectAssistantCharterConflictAction": {
      "type": "string",
      "enum": [
        "follow_charter",
        "change_charter",
        "dismiss"
      ],
      "description": "The person's choice for one report."
    },
    "ProjectAssistantCharterConflict": {
      "type": "object",
      "additionalProperties": false,
      "description": "One Bot's report that a sentence of its own disagrees with the charter. outdated says it was made against an older version than the current one.",
      "properties": {
        "id": {
          "type": "string"
        },
        "bot_id": {
          "type": "string"
        },
        "bot_name": {
          "type": "string",
          "description": "The Bot's name, empty when it is hidden or gone."
        },
        "turn_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "outdated": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/ProjectAssistantCharterConflictSource"
        },
        "path": {
          "type": "string",
          "description": "Workspace-relative file path; empty unless source is workspace_file."
        },
        "memory_entry_id": {
          "type": "string",
          "description": "The memory entry the Bot named; may be empty."
        },
        "bot_sentence": {
          "type": "string"
        },
        "charter_sentence": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "suggested": {
          "type": "string",
          "description": "The Bot's suggested replacement; empty to remove its sentence."
        },
        "state": {
          "$ref": "#/$defs/ProjectAssistantCharterConflictState"
        },
        "created_at": {
          "type": "string"
        },
        "resolved_at": {
          "type": "string",
          "description": "Empty while open."
        }
      },
      "required": [
        "id",
        "bot_id",
        "bot_name",
        "turn_id",
        "version",
        "outdated",
        "source",
        "path",
        "memory_entry_id",
        "bot_sentence",
        "charter_sentence",
        "section",
        "suggested",
        "state",
        "created_at",
        "resolved_at"
      ]
    },
    "ProjectAssistantCharterConflictsResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Project's conflict reports, open ones first, newest first (API 124). checked_without_report counts the visible Bots that were asked to compare the current version and reported nothing against it. Each report is one Bot's own judgment and may miss things.",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantCharterConflict"
          }
        },
        "checked_without_report": {
          "type": "integer",
          "minimum": 0
        },
        "limits": {
          "$ref": "#/$defs/ProjectAssistantCharterConflictLimits"
        }
      },
      "required": [
        "contract_version",
        "machine_id",
        "project_id",
        "version",
        "conflicts",
        "checked_without_report",
        "limits"
      ]
    },
    "ProjectAssistantCharterConflictLimits": {
      "type": "object",
      "additionalProperties": false,
      "description": "The conflict report bounds.",
      "properties": {
        "open": {
          "type": "integer",
          "minimum": 1
        },
        "resolved": {
          "type": "integer",
          "minimum": 1
        },
        "sentence_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "open",
        "resolved",
        "sentence_bytes"
      ]
    },
    "ProjectAssistantCharterConflictResolveRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "The person's choice for one open report (API 124). follow_charter replaces the Bot's sentence in its memory fact or instructions when it appears exactly once, otherwise asks the Bot to change it; change_charter marks the report handed to a charter change the person then requests; dismiss leaves everything as it is. A repeated key finishes the plan it chose; another key on a handled report is stale.",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "conflict_id": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ProjectAssistantCharterConflictAction"
        }
      },
      "required": [
        "machine_id",
        "project_id",
        "idempotency_key",
        "conflict_id",
        "action"
      ]
    }
  }
}
