{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handover.schema.json",
  "title": "The hand-over plane",
  "description": "Handoffs, Root Assignments, task graphs and the reclamation sweep (docs/design-decisions.md §6 W6). Every route here takes this machine's orchestrator token, reads included.",
  "$defs": {
    "BrokerHandoffState": {
      "description": "Where a handoff is: `opening` until the receiver's tab has a composer, then `delivered` when the one line was typed into it (typed, not read — the receiver's first turn is the read), or `spawn_failed` when it could not be.",
      "type": "string",
      "enum": ["opening", "delivered", "spawn_failed"]
    },
    "BrokerOpenedSession": {
      "description": "A tab this broker opened for somebody who is not its child.",
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_id", "backend", "opened_at"],
      "properties": {
        "terminal_id": { "type": "string" },
        "backend": { "type": "string", "enum": ["tmux", "iterm"] },
        "opened_at": { "type": "integer" },
        "auto_compact_window": { "description": "The context size in tokens a Claude session was opened to compact at — the machine's `claude_auto_compact_window` then — and 0 when none was applied. Null for Codex, which is never given one, and on a record from before it was kept.", "nullable": true, "type": "integer" }
      }
    },
    "BrokerHandoffRequest": {
      "description": "POST /v1/orchestrator/handoffs, a closed body. The package is written first at `<package_root>/<handoff_id>/handoff.md` (REFERENCES, VERIFICATION, OPEN THREADS). `coordinator_plain_handoff` must be the JSON value true: the machine role's holder hands over by succession instead.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "project_dir", "from_session", "coordinator_plain_handoff"],
      "properties": {
        "handoff_id": { "description": "A lowercase UUID the sender chose; a resend with it is the same handoff.", "type": "string" },
        "project_dir": { "type": "string" },
        "assistant": { "description": "claude (the default) or codex.", "type": "string" },
        "model": { "type": "string" },
        "title": { "description": "At most 200 characters.", "type": "string" },
        "from_session": { "description": "The sender's conversation id; it must be one live session on this machine.", "type": "string" },
        "coordinator_plain_handoff": { "type": "boolean" }
      }
    },
    "BrokerHandoff": {
      "description": "One handoff. `type_attempted_at` is recorded before the line is typed and is why it is never typed twice; `receipt` is what the sender was told, once, as a `handoff_receipt` notice.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "state", "project_dir", "dir", "from_session", "coordinator_plain_handoff", "assistant", "created"],
      "properties": {
        "handoff_id": { "type": "string" },
        "state": { "$ref": "#/$defs/BrokerHandoffState" },
        "project_dir": { "type": "string" },
        "dir": { "description": "The package's directory.", "type": "string" },
        "title": { "type": "string" },
        "from_session": { "type": "string" },
        "from_terminal": { "type": "string" },
        "coordinator_plain_handoff": { "type": "boolean" },
        "assistant": { "type": "string" },
        "model": { "type": "string" },
        "created": { "type": "integer" },
        "opened": { "$ref": "#/$defs/BrokerOpenedSession" },
        "type_attempted_at": { "type": "integer" },
        "delivered_at": { "type": "integer" },
        "failure": { "type": "string" },
        "receipt": { "type": "string" }
      }
    },
    "BrokerHandoffResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "replayed", "handoff"],
      "properties": {
        "ok": { "type": "boolean" },
        "replayed": { "description": "True when this handoff_id was already opened; nothing was opened or typed again.", "type": "boolean" },
        "handoff": { "$ref": "#/$defs/BrokerHandoff" }
      }
    },
    "BrokerHandoffEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff"],
      "properties": { "handoff": { "$ref": "#/$defs/BrokerHandoff" } }
    },
    "BrokerHandoffList": {
      "description": "The newest handoffs first, at most 200.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handoffs", "package_root", "at"],
      "properties": {
        "handoffs": { "type": "array", "items": { "$ref": "#/$defs/BrokerHandoff" } },
        "package_root": { "description": "Where a sender writes `<handoff_id>/handoff.md`. This daemon's own addition: the Swift broker hardcodes /tmp/.clawdline/handoffs.", "type": "string" },
        "at": { "type": "integer" }
      }
    },
    "BrokerAssignment": {
      "description": "The five things a Feature Root is briefed with, and nothing else: each 1–8192 bytes, not blank, no NUL; 32768 bytes together.",
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "scope", "constraints", "relevant_references", "acceptance"],
      "properties": {
        "objective": { "type": "string" },
        "scope": { "type": "string" },
        "constraints": { "type": "string" },
        "relevant_references": { "type": "string" },
        "acceptance": { "type": "string" }
      }
    },
    "BrokerRootAssignmentRequest": {
      "description": "POST /v1/orchestrator/root-assignments, a closed body, with an `Idempotency-Key` header equal to `request_id`. The same request resent is replayed; another assignment under the same request_id is 409 `request_conflict`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "assistant", "project_dir", "label", "assignment"],
      "properties": {
        "request_id": { "type": "string" },
        "assistant": { "type": "string", "enum": ["claude", "codex"] },
        "model": { "description": "\"default\" or a model name.", "type": "string" },
        "project_dir": { "type": "string" },
        "label": { "type": "string" },
        "assignment": { "$ref": "#/$defs/BrokerAssignment" }
      }
    },
    "BrokerRootAssignmentState": {
      "type": "string",
      "enum": ["accepted", "terminal_opened", "briefed", "failed"]
    },
    "BrokerRootAssignment": {
      "description": "One independently owned Feature Root. It carries no child lineage — no task, parent, secret, timeout, result or landing — and a reader can tell by its shape. The brief is the file at `brief_path`; the one line typed names it. `brief_attempted_at` is durable before the keystroke, so the brief is typed at most once.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request_id", "assistant", "model", "project_dir", "label", "state", "assignment", "created_at", "ownership", "brief_path"],
      "properties": {
        "id": { "type": "string" },
        "request_id": { "type": "string" },
        "assistant": { "type": "string" },
        "model": { "type": "string" },
        "project_dir": { "type": "string" },
        "label": { "type": "string" },
        "state": { "$ref": "#/$defs/BrokerRootAssignmentState" },
        "assignment": { "$ref": "#/$defs/BrokerAssignment" },
        "created_at": { "type": "integer" },
        "ownership": { "type": "string", "enum": ["independent_root"] },
        "executor": { "$ref": "#/$defs/BrokerOpenedSession" },
        "brief_path": { "type": "string" },
        "brief_attempted_at": { "type": "integer" },
        "briefed_at": { "type": "integer" },
        "failure": { "type": "string" }
      }
    },
    "BrokerRootAssignmentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "replayed", "root_assignment"],
      "properties": {
        "ok": { "type": "boolean" },
        "replayed": { "type": "boolean" },
        "root_assignment": { "$ref": "#/$defs/BrokerRootAssignment" }
      }
    },
    "BrokerRootAssignmentEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_assignment"],
      "properties": { "root_assignment": { "$ref": "#/$defs/BrokerRootAssignment" } }
    },
    "BrokerRootAssignmentList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_assignments", "at"],
      "properties": {
        "root_assignments": { "type": "array", "items": { "$ref": "#/$defs/BrokerRootAssignment" } },
        "at": { "type": "integer" }
      }
    },
    "BrokerGraphNodeKind": {
      "type": "string",
      "enum": ["decision", "delivery", "review", "correction", "verification", "landing"]
    },
    "BrokerGraphNodeState": {
      "description": "Read from the node's latest task every time it is asked, never stored. `done` for a node whose work lands needs the landing's proof (D17), not the word `landed` alone.",
      "type": "string",
      "enum": ["ready", "blocked", "active", "failed", "done", "changes_required", "awaiting_landing"]
    },
    "BrokerGraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "depends_on", "acceptance", "state"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "$ref": "#/$defs/BrokerGraphNodeKind" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "array", "items": { "type": "string" } },
        "state": { "$ref": "#/$defs/BrokerGraphNodeState" },
        "task_id": { "type": "string" }
      }
    },
    "BrokerGraph": {
      "description": "One task graph as its tasks say it is now. `frontier` is the nodes a dispatch may take now; `conflicts` names every task whose graph disagrees with the first definition read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "destination", "nodes", "frontier"],
      "properties": {
        "id": { "type": "string" },
        "destination": { "type": "string" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/BrokerGraphNode" } },
        "frontier": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "BrokerGraphList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphs", "at"],
      "properties": {
        "graphs": { "type": "array", "items": { "$ref": "#/$defs/BrokerGraph" } },
        "at": { "type": "integer" }
      }
    },
    "BrokerReclaimSubject": { "type": "string", "enum": ["worktree", "task_dir"] },
    "BrokerReclaimOutcome": {
      "description": "`removing` is the intent recorded before a removal is attempted; the `would_` pair is a dry run's.",
      "type": "string",
      "enum": ["removed", "preserved_and_removed", "kept", "removing", "would_remove", "would_preserve_and_remove"]
    },
    "BrokerReclaimEvidence": {
      "description": "What a decision rested on. Every key is optional: a kept decision carries the answer that was missing, a removal every answer it needed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminal": { "type": "string" },
        "backend": { "type": "string" },
        "tab": { "description": "`absent_from_complete_source` or `never_opened`.", "type": "string" },
        "process_table": { "type": "string" },
        "working_inside": { "description": "A process working directory inside the subject — the reason it was kept.", "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "base": { "type": "string" },
        "head": { "type": "string" },
        "branch_tip": { "type": "string" },
        "tree": { "type": "string" },
        "head_tree": { "type": "string" },
        "dirty": { "type": "boolean", "nullable": true },
        "commits_over_base": { "type": "integer", "nullable": true },
        "landing_target": { "type": "string" },
        "landing_commit": { "type": "string" },
        "target_commit": { "type": "string" },
        "head_on_target": { "type": "boolean", "nullable": true },
        "preservation_branch": { "type": "string" },
        "preservation_commit": { "type": "string" },
        "patch": { "type": "string" },
        "patch_sha256": { "type": "string" },
        "patch_bytes": { "type": "integer" },
        "patch_gives_tree": { "type": "string" },
        "nested": { "type": "string" },
        "problem": { "description": "The error that left a question unanswered, when one did.", "type": "string" }
      }
    },
    "BrokerReclaimDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "subject", "path", "outcome", "reason", "bytes"],
      "properties": {
        "task": { "type": "string" },
        "subject": { "$ref": "#/$defs/BrokerReclaimSubject" },
        "path": { "type": "string" },
        "outcome": { "$ref": "#/$defs/BrokerReclaimOutcome" },
        "reason": { "description": "removed: landed, empty, committed_on_branch, preserved, work_scratch. kept: task_live, within_grace, owner_present, owner_unknown, path_not_owned, unreadable, nested_repository, filters_present, preserve_failed, changed_during_sweep, intent_not_recorded, remove_failed.", "type": "string" },
        "bytes": { "type": "integer" },
        "evidence": { "$ref": "#/$defs/BrokerReclaimEvidence" }
      }
    },
    "BrokerReclaimReport": {
      "description": "One sweep. `foreign` names at most 64 entries under the checkout and task roots that no record names — never touched — and `foreign_count` is all of them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "dry_run", "decisions", "foreign", "foreign_count", "removed", "preserved", "kept", "bytes_freed", "deferred", "unreadable"],
      "properties": {
        "at": { "type": "integer" },
        "dry_run": { "type": "boolean" },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/BrokerReclaimDecision" } },
        "foreign": { "type": "array", "items": { "type": "string" } },
        "foreign_count": { "type": "integer" },
        "removed": { "type": "integer" },
        "preserved": { "type": "integer" },
        "kept": { "type": "integer" },
        "bytes_freed": { "type": "integer" },
        "deferred": { "type": "integer" },
        "unreadable": { "type": "integer" }
      }
    },
    "BrokerReclaimRequest": {
      "description": "POST /v1/orchestrator/reclaim. A dry run unless `dry_run` is false: the request that removes files is the one that has to say so.",
      "type": "object",
      "additionalProperties": false,
      "properties": { "dry_run": { "type": "boolean" } }
    },
    "BrokerReclaimStanding": {
      "description": "A decision as it stands, and since when. Said once: its event is written when it is new or changes, never every sweep (#46).",
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "subject", "outcome", "reason", "bytes", "since", "last_seen"],
      "properties": {
        "task": { "type": "string" },
        "subject": { "$ref": "#/$defs/BrokerReclaimSubject" },
        "outcome": { "$ref": "#/$defs/BrokerReclaimOutcome" },
        "reason": { "type": "string" },
        "bytes": { "type": "integer" },
        "since": { "type": "integer" },
        "last_seen": { "type": "integer" },
        "evidence": { "$ref": "#/$defs/BrokerReclaimEvidence" }
      }
    },
    "BrokerReclaimState": {
      "description": "GET /v1/orchestrator/reclaim: the last real sweep (null before the first), every standing decision, and where checkouts and preserved patches live.",
      "type": "object",
      "additionalProperties": false,
      "required": ["last", "decisions", "worktree_root", "reclaimed_root", "at"],
      "properties": {
        "last": { "$ref": "#/$defs/BrokerReclaimReport", "nullable": true },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/BrokerReclaimStanding" } },
        "worktree_root": { "type": "string" },
        "reclaimed_root": { "type": "string" },
        "at": { "type": "integer" }
      }
    }
  }
}
