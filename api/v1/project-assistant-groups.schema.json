{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-assistant-groups.v1",
  "title": "Human group rooms and team approval cards",
  "$defs": {
    "ProjectAssistantGroupMember": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "joined_revision": {
          "type": "integer"
        }
      },
      "required": [
        "key",
        "joined_revision"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroup": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "project": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantProjectScope"
        },
        "conversation_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantGroupMember"
          }
        },
        "membership_revision": {
          "type": "integer"
        },
        "version": {
          "type": "integer"
        },
        "deleted": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "last_entry": {
          "$ref": "#/$defs/ProjectAssistantRoomEntry",
          "description": "Optional latest stored room line; omitted when unavailable within the existing read budget."
        },
        "room": {
          "$ref": "#/$defs/ProjectAssistantRoomState",
          "description": "Optional room state read with group metadata and the latest line."
        }
      },
      "required": [
        "key",
        "project",
        "conversation_id",
        "name",
        "members",
        "membership_revision",
        "version",
        "deleted",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantRoomEntry": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "member"
          ]
        },
        "author": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "text": {
          "type": "string"
        },
        "reply_to_author": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "at": {
          "type": "string",
          "description": "Source timestamp for new entries; old undated entries omit it."
        },
        "reactions": {
          "type": "array",
          "items": {
            "$ref": "project-assistants.v1#/$defs/ProjectAssistantReactionActor"
          }
        },
        "quote": {
          "$ref": "#/$defs/ProjectAssistantRoomQuote"
        }
      },
      "required": [
        "seq",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantRoomState": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer"
        },
        "epoch": {
          "type": "integer"
        },
        "running": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        },
        "stopped_at": {
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "epoch",
        "running",
        "pending",
        "stopped_at"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupListRequest": {
      "type": "object",
      "properties": {
        "machine_id": {
          "type": "string"
        }
      },
      "required": [
        "machine_id"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupListResponse": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "source": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantSourceStatus"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantGroup"
          }
        }
      },
      "required": [
        "contract_version",
        "source",
        "groups"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupHistoryRequest": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "before_seq": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        }
      },
      "required": [
        "key",
        "before_seq",
        "page_size"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupReactRequest": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantCommand"
        },
        "conversation_id": {
          "type": "string"
        },
        "group_version": {
          "type": "integer"
        },
        "message_seq": {
          "type": "integer"
        },
        "emoji": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        },
        "expected_revision": {
          "type": "integer"
        }
      },
      "required": [
        "command",
        "conversation_id",
        "group_version",
        "message_seq",
        "emoji",
        "present",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupHistoryResponse": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "source": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantSourceStatus"
        },
        "group": {
          "$ref": "#/$defs/ProjectAssistantGroup"
        },
        "room": {
          "$ref": "#/$defs/ProjectAssistantRoomState"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantRoomEntry"
          }
        },
        "next_before_seq": {
          "type": "integer"
        },
        "has_more": {
          "type": "boolean"
        },
        "activity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantRoomActivity"
          },
          "description": "Current room tickets under actual member execution fences, from the same read snapshot."
        },
        "member_outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantRoomMemberOutcome"
          },
          "description": "Latest authorized turn of each asked member in the current room round. No private conversation data is included."
        }
      },
      "required": [
        "contract_version",
        "source",
        "group",
        "room",
        "lines",
        "next_before_seq",
        "has_more"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupCreateSettings": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantProjectSelection"
        },
        "name": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
          }
        }
      },
      "required": [
        "target",
        "name",
        "members"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupCreateRequest": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantCommand"
        },
        "settings": {
          "$ref": "#/$defs/ProjectAssistantGroupCreateSettings"
        }
      },
      "required": [
        "command",
        "settings"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupEditSettings": {
      "type": "object",
      "properties": {
        "expected_version": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
          }
        }
      },
      "required": [
        "expected_version",
        "name",
        "members"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupEditRequest": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantCommand"
        },
        "settings": {
          "$ref": "#/$defs/ProjectAssistantGroupEditSettings"
        }
      },
      "required": [
        "command",
        "settings"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupDeleteRequest": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantCommand"
        },
        "expected_version": {
          "type": "integer"
        }
      },
      "required": [
        "command",
        "expected_version"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupStopRequest": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantCommand"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupSendRequest": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantCommand"
        },
        "text": {
          "type": "string"
        },
        "reply_to_author": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "quote": {
          "$ref": "#/$defs/ProjectAssistantRoomQuoteReference",
          "description": "Exact original line in this room; the source derives its author and text. Omission preserves legacy command digests."
        }
      },
      "required": [
        "command",
        "text"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupResponse": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/ProjectAssistantGroup"
        },
        "receipt": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantReceipt"
        }
      },
      "required": [
        "contract_version",
        "group",
        "receipt"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupSendResponse": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/ProjectAssistantRoomEntry"
        },
        "room": {
          "$ref": "#/$defs/ProjectAssistantRoomState"
        }
      },
      "required": [
        "contract_version",
        "entry",
        "room"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantGroupStopResponse": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "room": {
          "$ref": "#/$defs/ProjectAssistantRoomState"
        },
        "stopped": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "room",
        "stopped"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantTeamPlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "manager": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "manager_name": {
          "type": "string"
        },
        "target": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "operation": {
          "type": "string",
          "enum": [
            "create",
            "edit"
          ]
        },
        "detail": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "manager",
        "manager_name",
        "target",
        "operation",
        "detail",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantTeamPlansRequest": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantTeamPlansResponse": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantTeamPlan"
          }
        }
      },
      "required": [
        "contract_version",
        "plans"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantTeamAnswerRequest": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantCommand"
        },
        "plan_id": {
          "type": "string"
        },
        "allow": {
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "plan_id",
        "allow"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantTeamAnswerResponse": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "plan_id",
        "state"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantTeamEditSettings": {
      "type": "object",
      "additionalProperties": false,
      "description": "Editable settings; omitted fallback_agents preserves the saved chain, while an empty array clears it. Primary Agent and Project remain immutable.",
      "properties": {
        "expected_version": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "appearance": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantAppearance"
        },
        "instructions": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "description": "The agent mode the Bot works in: auto (or empty) for the agent's Auto mode, otherwise one the agent offers (API level 65)."
        },
        "permission_policy": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantPermissionPolicy",
          "description": "Empty leaves the permission setting unchanged (API level 65)."
        },
        "fallback_agents": {
          "type": "array",
          "items": {
            "$ref": "project-assistants.v1#/$defs/ProjectAssistantAgent"
          },
          "description": "Ordered unique default login identities. Omitted edits preserve saved settings; an explicit empty array clears them."
        },
        "background_threads": {
          "type": "integer",
          "description": "Maximum simultaneous background threads selected for this Bot."
        },
        "manage_team": {
          "type": "boolean"
        },
        "agent": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantAgent"
        },
        "notify": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ]
        },
        "runtime_settings": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantRuntimeSettings"
        },
        "login_profile": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantLoginSelection"
        },
        "extensions": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantExtensionSelection"
        },
        "fallback_steps": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ProjectAssistantFallbackStep"
          }
        }
      },
      "required": [
        "expected_version",
        "name",
        "appearance",
        "instructions",
        "manage_team"
      ]
    },
    "ProjectAssistantTeamSettingsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "settings"
      ],
      "properties": {
        "command": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantCommand"
        },
        "settings": {
          "$ref": "#/$defs/ProjectAssistantTeamEditSettings"
        }
      }
    },
    "ProjectAssistantRoomQuote": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "member"
          ]
        },
        "author": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean",
          "description": "The source excerpt exceeded the existing message byte budget; seq still identifies the complete original line."
        }
      },
      "required": [
        "seq",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantRoomActivity": {
      "type": "object",
      "properties": {
        "member": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "turn_id": {
          "type": "string"
        },
        "state": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantTurnState"
        }
      },
      "required": [
        "member",
        "turn_id",
        "state"
      ],
      "additionalProperties": false
    },
    "ProjectAssistantRoomMemberOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantBotKey"
        },
        "name": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "state": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantTurnState"
        },
        "disposition": {
          "type": "string",
          "enum": ["published", "quiet"],
          "description": "Room publication receipt. Absent when the source cannot prove either result."
        },
        "reply_seq": {
          "type": "integer",
          "description": "Sequence of a published room reply. Absent for quiet or unverified completion."
        },
        "late": {
          "type": "boolean"
        },
        "failure_code": {
          "type": "string"
        },
        "failure_field": {
          "type": "string"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAssistantRoomAttempt"
          }
        }
      },
      "required": ["member", "name", "turn_id", "state"]
    },
    "ProjectAssistantRoomAttempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "type": "integer"
        },
        "agent": {
          "$ref": "project-assistants.v1#/$defs/ProjectAssistantAgent"
        },
        "stage": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean",
          "description": "The source selected a different execution identity from the primary."
        },
        "primary_rest_reason": {
          "type": "string",
          "description": "Observed reason for skipping the resting primary identity. This is not a reset time."
        }
      },
      "required": ["ordinal", "agent", "stage"]
    },
    "ProjectAssistantRoomQuoteReference": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer"
        }
      },
      "required": [
        "seq"
      ],
      "additionalProperties": false
    }
  }
}
