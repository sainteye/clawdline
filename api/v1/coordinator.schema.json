{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coordinator.schema.json",
  "title": "The machine role",
  "description": "GET and POST /v1/coordinator. Registering is never a takeover. Rebinding is a three-field compare-and-swap that refuses while the holder is online, and refuses again when liveness is unknown.",
  "$defs": {
    "Liveness": {
      "description": "What a current inventory says about the bound process. An incomplete reading answers `unknown`, never `offline`: absence of evidence is not proof of death.",
      "type": "string",
      "enum": ["online", "offline", "unknown"]
    },
    "CoordinatorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assistant", "conversationId", "generation", "id", "label", "pid", "registeredAt", "sessionId"],
      "properties": {
        "assistant": { "$ref": "common.schema.json#/$defs/Assistant" },
        "conversationId": { "type": "string" },
        "generation": { "description": "Increments on every rebind, so a stale caller holding an old view cannot move a role that has already moved.", "type": "integer" },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "pid": { "type": "integer" },
        "reboundAt": { "type": "integer" },
        "registeredAt": { "type": "integer" },
        "sessionId": { "type": "string" }
      }
    },
    "CoordinatorSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "liveness", "registered"],
      "properties": {
        "candidates": { "type": "array", "items": { "type": "string" } },
        "liveness": { "$ref": "#/$defs/Liveness" },
        "record": { "nullable": true, "$ref": "#/$defs/CoordinatorRecord" },
        "registered": { "type": "boolean" }
      }
    },
    "CoordinatorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "record"],
      "properties": {
        "ok": { "type": "boolean" },
        "record": { "$ref": "#/$defs/CoordinatorRecord" }
      }
    },
    "CoordinatorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation"],
      "properties": {
        "assistant": { "$ref": "common.schema.json#/$defs/Assistant" },
        "conversationId": { "type": "string" },
        "expectGeneration": { "type": "integer" },
        "expectId": { "type": "string" },
        "label": { "type": "string" },
        "operation": { "type": "string", "enum": ["register", "rebind"] },
        "pid": { "type": "integer" },
        "sessionId": { "type": "string" }
      }
    }
  }
}
