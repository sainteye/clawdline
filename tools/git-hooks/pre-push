#!/bin/sh
# What may be published is what has already been through the scrub.
#
# This used to refuse every push, because the checkout's history was the
# unfiltered development one and the public repository's was a filter-repo
# rewrite of it. On 2026-09-22 `main` was rebased onto the published history,
# so the two are one line and `main` can be pushed directly. The other refs
# were not: 174 `clawdline/task/*` branches and `backup-before-unify` still
# carry the unfiltered history, and pushing one would publish what the rewrite
# removed. So this refuses by ref rather than refusing everything, and it
# verifies rather than trusting the name.
#
# Three answers, like the other guards here: 0 allowed, 1 refused, 2 could not
# check. Could-not-check is not a pass.
set -u
root=$(git rev-parse --show-toplevel) || exit 2
cd "$root" || exit 2

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac

  if [ "$remote_ref" != "refs/heads/main" ] && [ "$remote_ref" != "refs/heads/swift" ]; then
    echo "pre-push: refused $remote_ref." >&2
    echo "  Only main carries the scrubbed history. Every other ref here still has the" >&2
    echo "  development one, and publishing it would undo the rewrite. docs/publishing.md." >&2
    status=1
    continue
  fi
  [ "$remote_ref" = "refs/heads/swift" ] && continue

  if ! out=$(tools/check-private.sh 2>&1); then
    echo "pre-push: the working tree is not clean of private material." >&2
    echo "$out" >&2
    status=1
    continue
  fi

  # Judge by comparison, not by memory.
  #
  # `-new` was tried first and is wrong here: it records what it reports, so a
  # refused push passed on the second attempt. `-checkpoint -` keeps nothing,
  # but it also forces a full read and ignores -revs, so a range cannot be
  # asked about on its own. What is left is a control group: read what the
  # remote already publishes, read what this push would make it, and refuse
  # when the second carries more than the first. Measured 2026-09-22: 529
  # against 606 for a merge that would have published 77 further findings.
  count_findings() {
    # Plain text, not an escape: `\u2014` is a Python spelling of the em dash
    # and grep reads it literally, so an earlier version of this line counted
    # zero on both sides and waved a dangerous push through. Watched failing.
    tools/check-private.sh -history -revs="$1" -checkpoint - 2>&1 |
      grep -c 'history only' || true
  }

  after=$(count_findings "$local_sha")
  case "$remote_sha" in
    ""|0000000000000000000000000000000000000000) before=0 ;;
    *) if git cat-file -e "$remote_sha" 2>/dev/null; then before=$(count_findings "$remote_sha"); else
         echo "pre-push: the published commit $remote_sha is not here to compare against." >&2
         echo "  Run git fetch first; a push cannot be judged without it." >&2
         status=2; continue
       fi ;;
  esac

  if [ -z "$after" ] || [ -z "$before" ]; then
    echo "pre-push: could not count the history on one side; that is not a pass." >&2
    status=2; continue
  fi

  if [ "$after" -gt "$before" ]; then
    echo "pre-push: this push would publish $((after - before)) finding(s) the remote does not carry." >&2
    echo "  published=$before  after this push=$after" >&2
    echo "  Read docs/publishing.md. A branch cut before main was rebased onto the" >&2
    echo "  published history brings the unfiltered line with it; cherry-pick its" >&2
    echo "  content instead of merging it." >&2
    status=1
  fi
done

exit "$status"
