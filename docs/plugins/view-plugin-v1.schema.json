{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clawdline View Plugin v1 manifest",
  "description": "Experimental browser-local runtime manifest, revision 6. Covers are required for new installation and publication. A schema-valid manifest is not image-decoding or runtime acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "version",
    "hostApi",
    "name",
    "entry",
    "capabilities",
    "cover"
  ],
  "properties": {
    "cover": {
      "type": "string",
      "description": "Dedicated square, non-interlaced RGBA8 PNG with only IHDR, IDAT and IEND chunks, embedded as canonical base64. CRCs, inflated length and filter bytes are validated by the packer and host. The whole manifest must still fit 8192 UTF-8 bytes.",
      "pattern": "^data:image/png;base64,(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 8192,
      "x-maximum-side": 256
    },
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 256
    },
    "hostApi": {
      "const": 1
    },
    "name": {
      "type": "object",
      "required": [
        "en",
        "zh-Hant"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "zh-Hant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.html$",
      "maxLength": 256
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "sessions.read",
          "sessions.open"
        ]
      },
      "contains": {
        "const": "sessions.read"
      }
    }
  }
}
